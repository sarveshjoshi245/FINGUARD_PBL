require('dotenv').config();
const express = require('express');
const cors = require('cors');
const fs = require('fs');
const path = require('path');
const yaml = require('js-yaml');
const OpenAI = require('openai');
const os = require('os');

// Import configurations
const appConfig = require('./config/app.config');
const aiConfig = require('./config/ai.config');
const dbConfig = require('./config/db.config');

// Import service factory
const { initializeServices, getServices } = require('./services/serviceFactory');

const app = express();
app.use(cors());
app.use(express.json());
app.use(express.static(path.join(__dirname, '../../frontend/src'))); // Serve frontend files

/* ================= SERVICE INITIALIZATION ================= */
let services = null;

// Initialize services on startup
const initApp = async () => {
  try {
    const dbPath = path.join(os.tmpdir(), 'sbi_digital_account_db.json');
    services = await initializeServices(dbPath);
    console.log('✅ All services initialized');
  } catch (error) {
    console.error('❌ Failed to initialize services:', error);
    process.exit(1);
  }
};

/* ================= LOCAL STORAGE SETUP ================= */
// Save the database in the OS temp folder so it never triggers Live Server
const DB_FILE = path.join(os.tmpdir(), 'sbi_digital_account_db.json');

function initDB() {
    if (!fs.existsSync(DB_FILE)) {
        const initialData = {
            applications: [],
            auditLogs: [],
            drafts: {} // Map of mobile -> { currentStep, tempData, lastUpdated }
        };
        fs.writeFileSync(DB_FILE, JSON.stringify(initialData, null, 2));
        console.log("📁 Initialized local database: db.json");
    }
}

function readDB() {
    try {
        const data = fs.readFileSync(DB_FILE, 'utf8');
        const db = JSON.parse(data);
        if (!db.drafts) db.drafts = {}; // Safety for existing DBs
        return db;
    } catch (e) {
        console.error("❌ Error reading local DB:", e);
        return { applications: [], auditLogs: [], drafts: {} };
    }
}

function writeDB(data) {
    try {
        fs.writeFileSync(DB_FILE, JSON.stringify(data, null, 2));
    } catch (e) {
        console.error("❌ Error writing to local DB:", e);
    }
}

initDB();

/* ================= LOAD AGENT CONFIG ================= */
const agentConfigPath = path.join(__dirname, 'sbi_onboarding_agent.yaml');
let agentConfig;
try {
    agentConfig = yaml.load(fs.readFileSync(agentConfigPath, 'utf8'));
    console.log(`✅ Agent loaded: ${agentConfig.name}`);
} catch (e) {
    console.error('❌ Failed to load agent YAML:', e.message);
    agentConfig = {
        name: 'SBI_Onboarding_Agent',
        instructions: 'You are an intelligent SBI-style banking onboarding assistant.'
    };
}

const SYSTEM_PROMPT = agentConfig.instructions;

/* ================= GROQ CLIENT ================= */
const GROQ_API_KEY = aiConfig.GROQ_API_KEY;
let openai;
try {
    openai = new OpenAI({
        apiKey: GROQ_API_KEY,
        baseURL: 'https://api.groq.com/openai/v1'
    });
    console.log('✅ Groq client initialized');
} catch (e) {
    console.error('❌ Groq init failed:', e.message);
}

const MODEL = aiConfig.GROQ_MODEL;

/* ================= SESSION STORE ================= */
const sessions = {};

function getSession(sessionId) {
    if (!sessions[sessionId]) {
        sessions[sessionId] = {
            messages: [{ role: 'system', content: SYSTEM_PROMPT }],
            step: 0,
            data: {}
        };
    }
    return sessions[sessionId];
}

/* ================= AUTHENTICATION ROUTES ================= */
const jwt = require('jsonwebtoken');
const bcrypt = require('bcrypt');
const authenticate = require('./middleware/authenticate');

// POST /api/auth/login - Admin login
app.post('/api/auth/login', async (req, res) => {
  try {
    const { username, password } = req.body;

    if (!username || !password) {
      return res.status(400).json({
        success: false,
        message: 'Username and password are required',
      });
    }

    // Read admins from JSON database
    const db = readDB();
    if (!db.admins) db.admins = [];

    // Find admin by username
    const admin = db.admins.find(a => a.username === username.toLowerCase());
    if (!admin) {
      return res.status(401).json({
        success: false,
        message: 'Invalid credentials',
      });
    }

    // Check if admin is blocked
    if (admin.status === 'BLOCKED') {
      return res.status(403).json({
        success: false,
        message: 'Account is blocked',
      });
    }

    // Verify password
    let isPasswordValid = false;
    try {
      isPasswordValid = await bcrypt.compare(password, admin.passwordHash);
    } catch (error) {
      // Fallback for plain text password (dev mode)
      isPasswordValid = password === admin.password;
    }

    if (!isPasswordValid) {
      return res.status(401).json({
        success: false,
        message: 'Invalid credentials',
      });
    }

    // Create JWT token
    const token = jwt.sign(
      {
        id: admin.id,
        username: admin.username,
        email: admin.email,
        role: admin.role,
      },
      process.env.JWT_SECRET || 'your_jwt_secret_key',
      { expiresIn: '24h' }
    );

    // Update last login
    admin.lastLogin = new Date().toISOString();
    db.admins = db.admins.map(a => a.username === username.toLowerCase() ? admin : a);
    writeDB(db);

    res.json({
      success: true,
      message: 'Login successful',
      token,
      admin: {
        id: admin.id,
        username: admin.username,
        email: admin.email,
        role: admin.role,
      },
    });
  } catch (error) {
    console.error('❌ Login error:', error);
    res.status(500).json({
      success: false,
      message: 'Login failed',
      error: error.message,
    });
  }
});

// GET /api/auth/me - Get current admin info (requires auth)
app.get('/api/auth/me', authenticate, async (req, res) => {
  try {
    const db = readDB();
    if (!db.admins) db.admins = [];

    const admin = db.admins.find(a => a.id === req.admin.id);
    if (!admin) {
      return res.status(404).json({
        success: false,
        message: 'Admin not found',
      });
    }

    res.json({
      success: true,
      admin: {
        id: admin.id,
        username: admin.username,
        email: admin.email,
        role: admin.role,
        status: admin.status,
      },
    });
  } catch (error) {
    console.error('❌ Auth check error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to fetch admin info',
    });
  }
});

// POST /api/auth/register-admin - Create initial admin (for first-time setup)
app.post('/api/auth/register-admin', async (req, res) => {
  try {
    const { username, email, password } = req.body;

    if (!username || !email || !password) {
      return res.status(400).json({
        success: false,
        message: 'Username, email, and password are required',
      });
    }

    const db = readDB();
    if (!db.admins) db.admins = [];

    // Check if admin already exists
    if (db.admins.length > 0 && db.admins.some(a => a.username === username.toLowerCase())) {
      return res.status(409).json({
        success: false,
        message: 'Admin already exists',
      });
    }

    // Hash password
    const salt = await bcrypt.genSalt(10);
    const passwordHash = await bcrypt.hash(password, salt);

    const newAdmin = {
      id: `ADMIN_${Date.now()}`,
      username: username.toLowerCase(),
      email: email.toLowerCase(),
      passwordHash,
      role: 'ADMIN',
      status: 'ACTIVE',
      permissions: ['view_applications', 'approve_applications', 'manage_admins'],
      createdAt: new Date().toISOString(),
      lastLogin: null,
    };

    db.admins.push(newAdmin);
    writeDB(db);

    res.json({
      success: true,
      message: 'Admin created successfully',
      admin: {
        id: newAdmin.id,
        username: newAdmin.username,
        email: newAdmin.email,
        role: newAdmin.role,
      },
    });
  } catch (error) {
    console.error('❌ Register admin error:', error);
    res.status(500).json({
      success: false,
      message: 'Failed to create admin',
      error: error.message,
    });
  }
});

/* ================= ADMIN CHAT ENDPOINT ================= */
app.post('/api/chat', async (req, res) => {
    try {
        const { message, history = [] } = req.body;
        if (!message) return res.status(400).json({ error: 'Message is required' });

        if (!openai) return res.status(500).json({ error: 'Groq not configured. Check your API key.' });

        const messages = [
            { role: 'system', content: SYSTEM_PROMPT + '\n\nYou are now in the Admin chat. Help the admin with questions about the onboarding process, risk scoring, compliance, and customer applications. Be professional and concise.' },
            ...history.map(h => ({ role: h.role, content: h.content })),
            { role: 'user', content: message }
        ];

        const completion = await openai.chat.completions.create({
            model: MODEL,
            messages: messages,
            max_tokens: 500,
            temperature: 0.7
        });

        const reply = completion.choices[0].message.content;
        res.json({ reply });
    } catch (error) {
        console.error('Chat error:', error.message);
        res.status(500).json({ error: 'AI service error: ' + error.message });
    }
});

/* ================= ONBOARDING ENDPOINT ================= */
app.post('/api/onboarding', async (req, res) => {
    try {
        const { sessionId, userMessage, stepData } = req.body;
        if (!sessionId) return res.status(400).json({ error: 'sessionId is required' });

        if (!openai) return res.status(500).json({ error: 'Groq not configured.' });

        const session = getSession(sessionId);

        if (stepData) {
            Object.assign(session.data, stepData);
        }

        let contextMsg = userMessage || '';
        if (stepData) {
            contextMsg += `\n\nCustomer data collected so far: ${JSON.stringify(session.data)}`;
        }

        if (contextMsg) {
            session.messages.push({ role: 'user', content: contextMsg });
        }

        const completion = await openai.chat.completions.create({
            model: MODEL,
            messages: session.messages,
            max_tokens: 600,
            temperature: 0.7
        });

        const reply = completion.choices[0].message.content;
        session.messages.push({ role: 'assistant', content: reply });
        session.step++;

        res.json({ reply, step: session.step, sessionId });
    } catch (error) {
        console.error('Onboarding error:', error.message);
        res.status(500).json({ error: 'AI service error: ' + error.message });
    }
});

/* ================= ONBOARDING RESET ================= */
app.post('/api/onboarding/reset', (req, res) => {
    const { sessionId } = req.body;
    if (sessionId && sessions[sessionId]) {
        delete sessions[sessionId];
    }
    res.json({ success: true, message: 'Session reset' });
});

/* ================= AGENT SIDEBAR ENDPOINT ================= */
const STEP_CONTEXT = {
    0: 'The customer has just arrived at the onboarding page. Welcome them warmly and explain what the process involves (document verification, face check, risk assessment). Be encouraging.',
    1: 'The customer is on Step 1: Personal Details. They need to enter Full Name, Aadhaar (12-digit number like 1234 5678 9012), PAN (10-char alphanumeric like ABCDE1234F), and Mobile (10 digits starting with 6-9). Help with any field-specific questions.',
    2: 'The customer is on Step 2: Document Upload/OCR. They upload Aadhaar card and PAN card images or PDFs. Our OCR extracts details automatically. Accepted formats: JPG, PNG, PDF. Advise: clear photo, good lighting, full document visible.',
    3: 'The customer is on Step 3: Face Verification. They use their webcam for a liveness check. It verifies they are a real person and matches their photo ID. Requires good lighting, looking directly at camera, and keeping still.',
    4: 'The customer is on Step 4: Income & Employment. They select annual income range and employment type (Salaried, Self-Employed, Business, Retired, Student, Other). This is used for risk assessment and product recommendations.',
    5: 'The customer is on Step 5: Risk Assessment. The AI system calculates a risk score (0-100). Low Risk (0-39): Auto-approved. Medium Risk (40-69): Manual review needed. High Risk (70+): Escalated for additional verification.',
    6: 'The customer has completed the onboarding. Their application is submitted. Guide them on next steps: confirmation SMS/email, account activation timeline (usually 24-48 hours), and how to contact support.'
};

const AGENT_SYSTEM_PROMPT = `You are the SBI Digital Account Opening Assistant — an AI agent embedded as a sidebar guide on the customer's onboarding dashboard.

YOUR ROLE:
- You sit alongside the onboarding form as a helpful guide
- You do NOT collect data yourself — the form handles that
- You EXPLAIN steps, ANSWER questions, and provide REASSURANCE
- You help with field-specific doubts (Aadhaar format, PAN format, etc.)

KNOWLEDGE BASE:
- Aadhaar: 12-digit unique identification number issued by UIDAI. Format: XXXX XXXX XXXX
- PAN: 10-character alphanumeric. Format: ABCDE1234F (5 letters, 4 numbers, 1 letter)
- Mobile: 10-digit Indian number starting with 6, 7, 8, or 9
- Face verification: Uses webcam for liveness detection (blink/nod) and photo matching
- Risk scoring: Based on income, employment type, and face verification score
- Data security: All data encrypted, processed per RBI and UIDAI guidelines, not shared with third parties

TONE: Professional, reassuring, concise. Use short paragraphs. Use bullet points for lists. Use emojis sparingly for warmth.

CRITICAL: Keep responses SHORT (2-4 sentences max for simple questions, 4-6 for complex ones). You are a sidebar assistant, not a full-page chatbot. Be direct and helpful.`;

app.post('/api/agent', async (req, res) => {
    try {
        const { message, sessionId: sid, currentStep: step } = req.body;
        if (!message) return res.status(400).json({ error: 'Message is required' });
        if (!openai) return res.status(500).json({ error: 'Groq not configured.' });

        const session = getSession(sid || 'default');

        // Build step-aware context
        const stepContext = STEP_CONTEXT[step] || STEP_CONTEXT[0];

        // Use a focused system prompt for sidebar responses
        const agentMessages = [
            { role: 'system', content: AGENT_SYSTEM_PROMPT + '\n\nCURRENT CONTEXT: ' + stepContext },
            ...session.messages.slice(-10).filter(m => m.role !== 'system'), // Last 10 messages for context
            { role: 'user', content: message }
        ];

        const completion = await openai.chat.completions.create({
            model: MODEL,
            messages: agentMessages,
            max_tokens: 300,
            temperature: 0.7
        });

        const reply = completion.choices[0].message.content;

        // Store in session for context continuity
        session.messages.push({ role: 'user', content: message });
        session.messages.push({ role: 'assistant', content: reply });

        res.json({ reply, step });
    } catch (error) {
        console.error('Agent error:', error.message);
        res.status(500).json({ error: 'AI service error: ' + error.message });
    }
});

/* ================= ENTITY PARSING ENDPOINT ================= */
app.post('/api/parse-entities', async (req, res) => {
    try {
        const { text } = req.body;
        if (!text) return res.status(400).json({ error: 'Text is required' });
        if (!openai) return res.status(500).json({ error: 'Groq not configured.' });

        const prompt = `Extract banking onboarding entities from the following user statement. 
Return ONLY a JSON object. If an entity is not found, use null.
Entities to extract:
- name: Full name
- aadhar: 12-digit number (format: XXXXXXXXXXXX)
- pan: 10-char alphanumeric (format: ABCDE1234F)
- mobile: 10-digit number
- income: Annual income amount if mentioned
- employment: Employment type if mentioned

User Statement: "${text}"

JSON Output:`;

        const completion = await openai.chat.completions.create({
            model: MODEL,
            messages: [{ role: 'system', content: 'You are a precise data extraction agent. Return only valid JSON.' }, { role: 'user', content: prompt }],
            max_tokens: 200,
            temperature: 0,
            response_format: { type: 'json_object' }
        });

        const entities = JSON.parse(completion.choices[0].message.content);
        res.json(entities);
    } catch (error) {
        console.error('Entity parsing error:', error.message);
        res.status(500).json({ error: 'Entity parsing failed' });
    }
});


/* ================= RISK SCORING ENDPOINT ================= */
app.post('/api/risk-score', (req, res) => {
    const { income, employmentType, faceScore } = req.body;

    // Start with a base risk for all digital submissions
    let riskPoints = 15;
    let breakdown = ['Base Digital Submission Risk: +15'];

    // More sensitive income check (Risk points if under 10L)
    const incomeVal = parseFloat(income);
    if (!isNaN(incomeVal) && incomeVal < 1000000) {
        const penalty = incomeVal < 300000 ? 30 : 15;
        riskPoints += penalty;
        breakdown.push(`Income < 10L: +${penalty}`);
    }

    if (employmentType && (employmentType.toLowerCase() === 'self-employed' || employmentType.toLowerCase() === 'business')) {
        riskPoints += 15;
        breakdown.push(`Self-Employed/Business: +15`);
    }

    if (faceScore && parseFloat(faceScore) < 95) {
        const facePenalty = parseFloat(faceScore) < 80 ? 40 : 20;
        riskPoints += facePenalty;
        breakdown.push(`Face Score < 95%: +${facePenalty}`);
    }

    // Clamp score at 100
    riskPoints = Math.min(riskPoints, 100);

    let classification;
    let status;

    // MANDATORY MANUAL REVIEW: All apps start as Flagged or Escalated
    if (riskPoints >= 70) {
        classification = 'High Risk - Escalated';
        status = 'Escalated';
    } else {
        classification = 'Manual Review Required';
        status = 'Flagged';
    }

    res.json({
        riskScore: riskPoints,
        risk_classification: classification,
        risk_breakdown: breakdown,
        status
    });
});

/* ================= STORAGE API ENDPOINTS ================= */
// GET all applications
app.get('/api/applications', (req, res) => {
    const db = readDB();
    res.json(db.applications);
});

// POST new application
app.post('/api/applications', (req, res) => {
    const newApp = req.body;
    if (!newApp.name) return res.status(400).json({ error: "Invalid application data" });

    const db = readDB();
    const appWithId = {
        ...newApp,
        id: newApp.id || Date.now() // Ensure it has a numeric ID for lookup
    };
    db.applications.push(appWithId);
    writeDB(db);

    console.log(`📦 Saved application for: ${newApp.name}`);
    res.json({ success: true, id: appWithId.id });
});

/* ================= DRAFT PERSISTENCE (RESUME FEATURE) ================= */

// Save or Update a draft
app.post('/api/drafts', (req, res) => {
    const { mobile, currentStep, tempData } = req.body;
    if (!mobile) return res.status(400).json({ error: "Mobile number required" });

    const db = readDB();
    db.drafts[mobile] = {
        currentStep,
        tempData,
        lastUpdated: new Date().toISOString()
    };
    writeDB(db);

    console.log(`📝 Draft saved for: ${mobile} (Step ${currentStep})`);
    res.json({ success: true });
});

// Fetch all drafts (for Admin)
app.get('/api/drafts', (req, res) => {
    const db = readDB();
    const draftsArray = Object.keys(db.drafts).map(mobile => ({
        id: `draft-${mobile}`,
        mobile,
        ...db.drafts[mobile],
        status: 'Dropped' // Virtual status for admin UI
    }));
    res.json(draftsArray);
});

// Fetch a specific draft
app.get('/api/drafts/:mobile', (req, res) => {
    const { mobile } = req.params;
    const db = readDB();
    const draft = db.drafts[mobile];

    if (!draft) {
        return res.status(404).json({ error: "No draft found for this mobile number" });
    }

    res.json(draft);
});

// PATCH update application (Approve/Reject)
app.patch('/api/applications/:id', (req, res) => {
    const id = req.params.id;
    const updates = req.body;

    const db = readDB();
    const index = db.applications.findIndex(a => String(a.id) === String(id));

    if (index === -1) return res.status(404).json({ error: "Application not found" });

    db.applications[index] = { ...db.applications[index], ...updates };
    writeDB(db);

    console.log(`📝 Updated application ${id} status to ${updates.status}`);
    res.json({ success: true });
});

// GET all audit logs
app.get('/api/audit-logs', (req, res) => {
    const db = readDB();
    // Return sorted newest first
    const sortedLogs = [...db.auditLogs].sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
    res.json(sortedLogs);
});

// POST new audit log
app.post('/api/audit-logs', (req, res) => {
    const log = req.body;
    const db = readDB();
    db.auditLogs.push({
        ...log,
        timestamp: log.timestamp || new Date().toISOString()
    });
    writeDB(db);
    res.json({ success: true });
});

/* ================= SERVE FRONTEND ================= */
app.get('/', (req, res) => {
    res.sendFile(path.join(__dirname, '../../frontend/src/index.html'));
});

/* ================= START SERVER ================= */
const PORT = appConfig.PORT;

const startServer = async () => {
    await initApp();
    
    app.listen(PORT, () => {
        console.log(`\n🏦 FINGUARD Platform running at http://localhost:${PORT}`);
        console.log(`📋 Agent: ${agentConfig.name}`);
        console.log(`🤖 Model: ${MODEL} (Groq)`);
        console.log(`🔑 Groq API Key: ${GROQ_API_KEY ? '✅ Configured' : '❌ Missing - set GROQ_API_KEY in .env'}\n`);
    });
};

// Start the server
startServer().catch(error => {
    console.error('❌ Failed to start server:', error);
    process.exit(1);
});

module.exports = app;
