# FINGUARD Backend Configuration
# Copy this file to .env and fill in your values

# Environment
NODE_ENV=development
PORT=3000

# AI Configuration (Groq)
# Get your API key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=mixtral-8x7b-32768

# Database Configuration
# OPTION 1: Local MongoDB
# Install MongoDB Community: https://www.mongodb.com/try/download/community
# Then use: mongodb://localhost:27017/finguard_db
#
# OPTION 2: MongoDB Atlas (Free Tier - Recommended)
# Sign up: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/finguard_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/finguard_db

# JWT Configuration
JWT_SECRET=your_very_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=24h

# Database Settings
DB_TYPE=mongodb
MONGODB_POOL_SIZE=10
MONGODB_TIMEOUT=5000

# Security
TRUST_PROXY=false

# CORS
CORS_ORIGIN=*
