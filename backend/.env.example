# FINGUARD Backend Configuration
# Copy this file to .env and fill in your values
# DO NOT commit your actual .env file to git.

# ── Environment ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── AI Configuration (Groq) ────────────────────────────────────────────────
# Get your API key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Database Configuration ─────────────────────────────────────────────────
# OPTION 1: Local MongoDB (if installed)
# MONGODB_URI=mongodb://localhost:27017/finguard_db
#
# OPTION 2: MongoDB Atlas (Free Tier — Recommended for deployment)
# Sign up: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/finguard_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/finguard_db
MONGO_URI=mongodb://localhost:27017/finguard_db

# ── JWT Configuration ──────────────────────────────────────────────────────
JWT_SECRET=your_very_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=24h

# ── Database Settings ──────────────────────────────────────────────────────
# Set to 'mongodb' to use Atlas, or 'json' for local file fallback
DB_TYPE=mongodb
MONGODB_POOL_SIZE=10
MONGODB_TIMEOUT=5000

# ── Security ───────────────────────────────────────────────────────────────
TRUST_PROXY=false

# ── CORS ───────────────────────────────────────────────────────────────────
# In production, set this to your Vercel frontend URL, e.g.:
# CORS_ORIGIN=https://finguard.vercel.app
CORS_ORIGIN=*
